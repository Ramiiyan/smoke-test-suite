# Newman reports - regenerated every run, ~2 MB each
reports/*.json

# Backups created by bootstrap-client.sh (may contain credentials)
*.orig

# Your filled-in environment. The committed file is a TEMPLATE with blank
# credentials; copy it to <something>.local.json, fill that in, and run against
# it. A populated environment holds client_secret and admin_pass in plain text
# and must never be committed.
*.local.json

.DS_Store

# Postman app local workspace files (created when this folder is opened in Postman)
.postman/
postman/
